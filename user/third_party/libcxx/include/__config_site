// OCTAGRAM configuration for the vendored libc++ headers.
//
// Upstream generates this file with CMake. OCTAGRAM keeps the default ABI
// (namespace __1, ABI version 1), turns hardening checks off (a hardening
// failure would abort a freestanding guest program with no way to report it),
// selects the serial PSTL backend because there is no thread pool yet, and
// provides its own ctype/rune table because OCTAGRAM does not implement the
// glibc, musl or newlib locale internals libc++ would otherwise detect.
// Upstream generates this from CMake; without it the inline namespace would
// literally be named _LIBCPP_ABI_NAMESPACE instead of __1.
#define _LIBCPP_ABI_NAMESPACE __1
#define _LIBCPP_HARDENING_MODE _LIBCPP_HARDENING_MODE_NONE
#define _LIBCPP_PSTL_CPU_BACKEND_SERIAL 1
#define _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE
// OCTAGRAM provides clock_gettime() (syscall 50) for REALTIME and MONOTONIC,
// so libc++ should use it for std::chrono::steady_clock instead of failing the
// "Monotonic clock not implemented" gate in src/chrono.cpp.
#define _LIBCPP_HAS_CLOCK_GETTIME

// std::basic_osyncstream, <tzdb> and stop_token are marked experimental in
// this libc++ snapshot; they are complete enough for the native toolchain and
// the container probe exercises osyncstream, so enable them.
#define _LIBCPP_ENABLE_EXPERIMENTAL 1
